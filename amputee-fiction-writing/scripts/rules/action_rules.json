    },
    {
      "id": "ACT-PH-01", "applies_to": ["PH"], "severity": "warning", "automated": false,
      "description": "超出角色卡登记残留指能力的精细动作（人工审查）",
      "patterns": []
    },
    {
      "id": "ACT-BUL-01", "applies_to": ["BUL"], "severity": "warning",
      "description": "双侧上肢截肢者持物动作缺少代偿说明",
