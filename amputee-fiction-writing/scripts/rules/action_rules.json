      "allow_context": ["拐", "轮椅", "拄", "撑", "扶"]
    },
    {
      "id": "ACT-LEG-02", "applies_to": ["HD", "TF", "KD", "TT"], "severity": "error",
      "description": "跑、奔、跳跃、冲刺类动作",
      "patterns": ["奔跑", "跑步", "狂奔", "飞奔", "跳跃", "跳起", "一跃", "冲刺", "跑了", "跑去", "跑向"],
      "allow_context": ["轮椅", "豁免"]
