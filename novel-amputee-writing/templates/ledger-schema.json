{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-amputee-writing.local/templates/ledger-schema.json",
  "title": "状态账本核心字段契约（跨平台最小子集）",
  "description": "方向③的结构化契约。只覆盖**可形式化判定**的字段；散文式规则、文笔、生理事实语义不在本 schema 管辖范围。托管 API 可用 native structured output 做格式保证，但格式合法 ≠ 内容合规：账本写完仍须过 gatecheck 与冷读。",
  "type": "object",
  "required": ["角色固定属性", "本章登记", "工作流执行日志"],
  "properties": {
    "角色固定属性": {
      "type": "object",
      "required": ["工作流模式", "亲密尺度档"],
      "properties": {
        "工作流模式": { "type": "string", "enum": ["flash", "pro", "max"] },
        "亲密尺度档": { "type": "string", "enum": ["A 含蓄", "B 情色（半程）", "C 成人（全程）"], "description": "模板初值可能写裸字母 A/B/C 作占位；正式落盘须填本 enum 全称" },
        "截肢时长档位": { "type": "string", "enum": ["先天档", "近期档", "多年档"] },
        "冲突强度档": { "type": "string", "enum": ["烈", "高", "中", "低"] },
        "题材大类": { "type": "string", "enum": ["现实向", "幻想向", "末世生存", "古装向"] },
        "辅具类型": { "type": "string" }
      },
      "additionalProperties": true
    },
    "本章登记": {
      "type": "object",
      "properties": {
        "亲密戏登记": {
          "type": "object",
          "properties": {
            "档位": { "type": "string", "enum": ["A 含蓄", "B 情色（半程）", "C 成人（全程）"] },
            "硬闸自查": {
              "type": "object",
              "description": "B/C 档时四项必填且实判；gatecheck [15] 强制",
              "properties": {
                "成年": { "$ref": "#/$defs/闸判定" },
                "非自愿": { "$ref": "#/$defs/闸判定" },
                "同意": { "$ref": "#/$defs/闸判定" },
                "疼痛非快感": { "$ref": "#/$defs/闸判定" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "资源账": {
      "type": "object",
      "description": "仅末世/生存题材启用；gatecheck [16] 校验连续 3 章未推进记账章",
      "properties": {
        "启用": { "type": "string", "enum": ["是", "否"] },
        "上次记账章": { "type": ["integer", "null"], "minimum": 0 },
        "水": { "type": ["number", "string", "null"] },
        "食物": { "type": ["number", "string", "null"] },
        "药": { "type": ["number", "string", "null"] },
        "燃料": { "type": ["number", "string", "null"] },
        "子弹": { "type": ["number", "string", "null"] },
        "电池": { "type": ["number", "string", "null"] },
        "本场变动": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "章节状态": {
      "type": "object",
      "description": "状态机层（方向③）；缺该块时 gatecheck [17] 跳过以兼容旧账本",
      "properties": {
        "当前章": { "type": ["integer", "null"] },
        "当前态": { "$ref": "#/$defs/章节态" },
        "轨迹": {
          "type": "array",
          "items": { "$ref": "#/$defs/章节态" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "工作流执行日志": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["章", "选定模式", "实际执行模式", "交付闸"],
        "properties": {
          "章": { "type": "integer", "minimum": 1 },
          "选定模式": { "type": "string", "enum": ["flash", "pro", "max"] },
          "实际执行模式": { "type": "string", "enum": ["flash", "pro", "max"] },
          "交付闸": { "type": "string", "enum": ["通过"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "闸判定": { "type": "string", "enum": ["通过", "不适用", "不通过", "待查"] },
    "章节态": {
      "type": "string",
      "enum": ["待规划", "已规划", "写作中", "已自查", "已冷读", "已修正", "已过闸", "已交付"]
    }
  }
}
